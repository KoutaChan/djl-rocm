GITHUB_URL=https://github.com/OWNER/REPO

# Keep this empty for long-running containers. Pass the short-lived
# registration token only on the RUNNER_CONFIG_ONLY=true command line.
RUNNER_TOKEN=

# Optional runner names.
RUNNER1_NAME=djl-linux-docker-1
RUNNER2_NAME=djl-linux-docker-2
RUNNER3_NAME=djl-linux-docker-3
RUNNER_LABELS=djl-linux-docker,docker
RUNNER_GROUP=
RUNNER_VERSION=
RUNNER_EPHEMERAL=false
RUNNER_CONFIG_ONLY=false
