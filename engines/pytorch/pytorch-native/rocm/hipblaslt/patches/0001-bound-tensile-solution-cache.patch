+++ b/projects/hipblaslt/tensilelite/tests/CacheMap_test.cpp
@@ -0,0 +1,132 @@
+// Copyright Advanced Micro Devices, Inc., or its affiliates.
+// SPDX-License-Identifier: MIT
+
+#include <Tensile/CachingLibrary.hpp>
+#include <gtest/gtest.h>
+
+#include <memory>
+#include <thread>
+#include <vector>
+
+using namespace TensileLite;
+
+TEST(CacheMapTest, BoundsRetainedProblemsAndKeepsRecentHits)
+{
+    CacheMap<int, int> cache(-1);
+    for(int key = 0; key < 4096; ++key)
+        cache.add(key, key);
+    EXPECT_EQ(cache.find(0), 0);
+    cache.add(4096, 4096);
+    EXPECT_EQ(cache.find(1), -1);
+    EXPECT_EQ(cache.find(0), 0);
+    EXPECT_EQ(cache.find(4096), 4096);
+
+    for(int key = 4097; key < 8192; ++key)
+        cache.add(key, key);
+    int retained = 0;
+    for(int key = 0; key < 8192; ++key)
+        retained += cache.find(key) != -1;
+    EXPECT_EQ(retained, 4096);
+}
+
+TEST(CacheMapTest, UpdatesRefreshRecencyWithoutConsumingCapacity)
+{
+    CacheMap<int, int> cache(-1);
+    for(int key = 0; key < 4096; ++key)
+        cache.add(key, key);
+    cache.add(10000, 0);
+    cache.add(4096, 4096);
+    EXPECT_EQ(cache.find(0), 10000);
+    EXPECT_EQ(cache.find(1), -1);
+    EXPECT_EQ(cache.find(2), 2);
+}
+
+TEST(CacheMapTest, MultiLevelValuesShareOneProblemSlot)
+{
+    CacheMap<int, int, int> cache(-1);
+    for(int problem = 0; problem < 4096; ++problem)
+    {
+        cache.add(problem, problem, 0);
+        cache.add(problem + 10000, problem, 1);
+    }
+    EXPECT_EQ(cache.find(0, 0), 0);
+    EXPECT_EQ(cache.find(0, 1), 10000);
+    cache.add(4096, 4096, 0);
+    EXPECT_EQ(cache.find(1, 0), -1);
+    EXPECT_EQ(cache.find(1, 1), -1);
+    EXPECT_EQ(cache.find(0, 1), 10000);
+}
+
+TEST(CacheMapTest, ReturnedValuesSurviveEviction)
+{
+    CacheMap<std::shared_ptr<int>, int> cache(nullptr);
+    cache.add(std::make_shared<int>(42), 0);
+    auto retained = cache.find(0);
+    for(int key = 1; key <= 4096; ++key)
+        cache.add(std::make_shared<int>(key), key);
+    EXPECT_EQ(cache.find(0), nullptr);
+    EXPECT_EQ(*retained, 42);
+}
+
+TEST(CacheMapTest, ConcurrentReadersAndWritersRemainBounded)
+{
+    CacheMap<std::shared_ptr<int>, int> cache(nullptr);
+    std::vector<std::thread> workers;
+    for(int worker = 0; worker < 4; ++worker)
+    {
+        workers.emplace_back([&, worker] {
+            for(int iteration = 0; iteration < 8192; ++iteration)
+            {
+                int key = (iteration * 7 + worker * 11) % 16384;
+                cache.add(std::make_shared<int>(key), key);
+                auto value = cache.find(key);
+                if(value)
+                    EXPECT_EQ(*value, key);
+            }
+        });
+    }
+    for(auto& worker : workers)
+        worker.join();
+    int retained = 0;
+    for(int key = 0; key < 16384; ++key)
+        retained += cache.find(key) != nullptr;
+    EXPECT_EQ(retained, 4096);
+}
+
+TEST(CacheMapTest, SolutionCompletionFlagIsEvictedWithItsSolutions)
+{
+    using Result = std::pair<std::vector<int>, bool>;
+    CacheMap<Result, int> cache(Result{{}, false});
+    cache.add(Result{{42}, true}, 0);
+    for(int key = 1; key <= 4096; ++key)
+        cache.add(Result{{key}, false}, key);
+    auto missing = cache.find(0);
+    EXPECT_TRUE(missing.first.empty());
+    EXPECT_FALSE(missing.second);
+    cache.add(Result{{7, 8}, false}, 0);
+    auto refreshed = cache.find(0);
+    EXPECT_EQ(refreshed.first, (std::vector<int>{7, 8}));
+    EXPECT_FALSE(refreshed.second);
+}
+
+TEST(CacheMapTest, ConcurrentSolutionMetadataIsOneSnapshot)
+{
+    using Result = std::pair<std::vector<int>, bool>;
+    CacheMap<Result, int> cache(Result{{}, false});
+    std::vector<std::thread> workers;
+    for(int worker = 0; worker < 4; ++worker)
+    {
+        workers.emplace_back([&, worker] {
+            for(int iteration = 0; iteration < 8192; ++iteration)
+            {
+                int generation = iteration * 4 + worker;
+                cache.add(Result{{generation}, generation % 2 == 0}, 0);
+                auto result = cache.find(0);
+                ASSERT_EQ(result.first.size(), 1);
+                EXPECT_EQ(result.second, result.first[0] % 2 == 0);
+            }
+        });
+    }
+    for(auto& worker : workers)
+        worker.join();
+}
